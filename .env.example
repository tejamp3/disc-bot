# Set at least one destination.

# Discord channel webhook URL (Channel settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# Telegram bot token (from @BotFather) and the chat, group or channel to post to
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: OpenRouter API key (https://openrouter.ai/keys) to enable the AI editor
OPENROUTER_API_KEY=
# Optional: model for the AI editor (default nvidia/nemotron-3-super-120b-a12b:free)
OPENROUTER_MODEL=
